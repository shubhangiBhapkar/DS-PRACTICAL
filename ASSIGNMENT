PRACTICAL 1 - Berkeley Algorithm 
import java.util.*;

public class BerkeleyAlgorithm {

    static int[] clockTimes = {0, 5, -10, 10};
    // Index 0 = master, 1,2,3 = slaves (offsets relative to master)

    public static void main(String[] args) {
        System.out.println("=== Berkeley Algorithm ===\n");

        // Step 1: Show initial clocks
        System.out.println("Initial clocks (absolute time):");
        int master = 10; // master's actual time
        int[] slaves = {master + clockTimes[1], master + clockTimes[2], master + clockTimes[3]};
        System.out.println("  Master: " + master);
        for (int i = 0; i < slaves.length; i++)
            System.out.println("  Slave " + (i+1) + ": " + slaves[i]);

        // Step 2: Master collects all times and computes average
        int total = master;
        for (int s : slaves) total += s;
        int average = total / (slaves.length + 1);
        System.out.println("\nAverage (synchronized) time: " + average);

        // Step 3: Compute adjustments
        System.out.println("\nAdjustments to send:");
        System.out.println("  Master adjust: " + (average - master));
        for (int i = 0; i < slaves.length; i++)
            System.out.println("  Slave " + (i+1) + " adjust: " + (average - slaves[i]));

        // Step 4: Apply adjustments
        System.out.println("\nAfter synchronization:");
        System.out.println("  Master: " + average);
        for (int i = 0; i < slaves.length; i++)
            System.out.println("  Slave " + (i+1) + ": " + (slaves[i] + (average - slaves[i])));
    }
}

