// TokenRing.java
import java.util.*;

public class TokenRing {

    public static void main(String[] args) {

        Scanner sc = new Scanner(System.in);

        System.out.print("Enter number of processes: ");
        int n = sc.nextInt();

        int[] processes = new int[n];

        // Initialize processes
        for (int i = 0; i < n; i++) {
            processes[i] = i;
        }

        System.out.print("Enter process having initial token: ");
        int token = sc.nextInt();

        System.out.print("Enter process requesting critical section: ");
        int request = sc.nextInt();

        System.out.println("\n--- Token Passing ---");

        int i = token;

        // Pass token until it reaches requesting process
        while (i != request) {
            System.out.println("Token passed from Process " + i +
                               " to Process " + ((i + 1) % n));
            i = (i + 1) % n;
        }

        // Critical Section
        System.out.println("\nProcess " + request + " enters Critical Section");
        System.out.println("Process " + request + " exits Critical Section");

        // Pass token to next process
        System.out.println("Token passed to Process " + ((request + 1) % n));

        sc.close();
    }
}
